msgid ""
"<span class=\"span6\" id=\"span8\">Ruta de Familias</span> Todos los "
"peregrinos que hagan la ruta de familias, independientemente de su capítulo "
"y región."
msgstr ""
"<span class=\"span6\" id=\"span8\">Rota das Famílias</span> Todos os "
"peregrinos que façam a rota das famílias, independentemente do seu capítulo "
