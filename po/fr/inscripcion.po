#: pages/inscripcion.html%2Bsection.label:21-4
msgid "Tarifas"
msgstr "Tarifs"

#: pages/inscripcion.html%2Bsection.ul.li:26-5
msgid "<b class=\"b8\">Adultos</b> mayores de 25: 55€"
msgstr "<b class=\"b8\">Adultes</b> de plus de 25 ans : 55 €"

#: pages/inscripcion.html%2Bsection.ul.li:27-5
msgid "<b class=\"b8\">Adultos</b> hasta 25: 45€"
msgstr "<b class=\"b8\">Adultes</b> jusqu'à 25 ans : 45 €"

#: pages/inscripcion.html%2Bsection.ul.li:28-5
msgid "<b class=\"b8\">Niños</b> (menores de 16): 25€"
msgstr "<b class=\"b8\">Enfants</b> (moins de 16 ans) : 25 €"

#: pages/inscripcion.html%2Bsection.ul.li:29-5
msgid "<b class=\"b8\">Niños</b> (menores de 6): 15€"
msgstr "<b class=\"b8\">Enfants</b> (moins de 6 ans) : 15 €"

#: pages/inscripcion.html%2Bsection.ul.li:30-5
msgid "<b class=\"b8\">Autobús Covadonga – Oviedo</b>: 5€/persona"
msgstr "<b class=\"b8\">Bus Covadonga – Oviedo</b> : 5 €/personne"

#: pages/inscripcion.html%2Bsection.ul.li:31-5
msgid ""
"<b class=\"b8\">Máximo por familia</b> (primer grado o abuelos y nietos): "
"180€"
msgstr ""
"<b class=\"b8\">Maximum par famille</b> (premier degré ou grands-parents et "
"petits-enfants) : 180 €"

#: pages/inscripcion.html%2Bsection.ul:31-97
msgid "Ver Normativa General"
msgstr "Voir le Règlement Général"
